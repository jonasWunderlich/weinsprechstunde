{
  "import_source": "local",
  "export_path": "./export/data/wines.json",
  "scaffold_mode": true,
  "image_export_dir": "./export/images",
  "image_resize_mode": "width",
  "image_resize_px": 1200,
  "optimize": {
    "enabled": true,
    "max_height": 1400,
    "quality": 85
  },
  "deploy": {
    "protocol": "ftpes",
    "remote_path": "/",
    "remote_images_path": "/images",
    "remote_import_path": "/data",
    "remote_editor_path": "/edit"
  },
  "backup": {
    "backup_dir": "./backup",
    "remote_backup_dir": "/backup",
    "max_last_backups": 10,
    "max_archival_backups": 24,
    "archival_interval_days": 30
  },
  "editor": {
    "path": "/editor-geheim",
    "password_hash": ""
  }
}
